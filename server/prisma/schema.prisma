// White-Label Multi-Tenant AI Automation SaaS Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT SAAS INFRASTRUCTURE & WHITE-LABELING
// ============================================================================

model Organization {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  logo            String?
  brandColor      String?   @default("#E0AA3E")
  portalTitle     String?   @default("MicroMind Business Suite")
  settings        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  members             OrganizationMember[]
  subscription        Subscription?
  dashboards          Dashboard[]
  reports             Report[]
  documents           Document[]
  chatHistory         ChatHistory[]
  customers           Customer[]
  followUpTasks       FollowUpTask[]
  projects            Project[]
  automationSequences AutomationSequence[]
  
  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String
  role            String   @default("MEMBER")
  createdAt       DateTime @default(now())
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Subscription {
  id                    String   @id @default(uuid())
  organizationId        String   @unique
  plan                  String   @default("FREE")
  status                String   @default("ACTIVE")
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean  @default(false)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

model Invitation {
  id              String    @id @default(uuid())
  organizationId  String
  email           String
  role            String    @default("MEMBER")
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedBy       String
  createdAt       DateTime  @default(now())
  
  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@map("invitations")
}

// ============================================================================
// CORE AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  displayName           String
  role                  String    @default("USER")
  active                Boolean   @default(true)
  currentOrganizationId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  // Relations
  sessions        Session[]
  memberships     OrganizationMember[]
  dashboards      Dashboard[]
  reports         Report[]
  
  @@index([email])
  @@index([role])
  @@index([currentOrganizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// ANALYTICS & REPORTING
// ============================================================================

model Dashboard {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String
  title           String
  description     String?
  sqlQuery        String?
  chartConfig     String?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([userId])
  @@index([isPublic])
  @@map("dashboards")
}

model Report {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String
  title           String
  description     String?
  content         String?
  format          String   @default("PDF")
  s3Path          String?
  createdAt       DateTime @default(now())
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("reports")
}

// ============================================================================
// DOCUMENT MANAGEMENT
// ============================================================================

model Document {
  id              String   @id @default(uuid())
  organizationId  String
  title           String
  description     String?
  fileType        String   @default("DOCUMENT")
  s3Path          String
  size            Int?
  uploadedBy      String?
  tags            String?  @default("")
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([fileType])
  @@index([uploadedBy])
  @@index([createdAt])
  @@map("documents")
}

// ============================================================================
// AI SERVICES
// ============================================================================

model ChatHistory {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String?
  agentType       String
  message         String
  response        String
  metadata        String?
  createdAt       DateTime @default(now())
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([userId])
  @@index([agentType])
  @@index([createdAt])
  @@map("chat_history")
}

// ============================================================================
// SMARTFOLLOW AI — CUSTOMER FOLLOW-UP & AUTOMATION MODELS
// ============================================================================

model Customer {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  company         String?
  email           String?
  phone           String?
  stage           String         @default("NEW_LEAD")
  healthScore     Int            @default(100)
  dealValue       Float          @default(0)
  assignedTo      String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interactions    Interaction[]
  followUpTasks   FollowUpTask[]
  callSummaries   CallSummary[]

  @@index([organizationId])
  @@index([stage])
  @@index([nextFollowUpAt])
  @@map("customers")
}

model FollowUpTask {
  id              String   @id @default(uuid())
  organizationId  String
  customerId      String
  title           String
  description     String?
  type            String   @default("CALL")
  status          String   @default("PENDING")
  dueDate         DateTime
  aiSuggestedMsg  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@map("follow_up_tasks")
}

model Interaction {
  id              String   @id @default(uuid())
  customerId      String
  channel         String
  summary         String
  sentiment       String?
  createdAt       DateTime @default(now())

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@map("interactions")
}

// ============================================================================
// PROJECTS MANAGEMENT
// ============================================================================

model Project {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  status          String        @default("ACTIVE")
  color           String?       @default("#E0AA3E")
  progress        Int           @default(0)
  startDate       DateTime?
  endDate         DateTime?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks           ProjectTask[]

  @@index([organizationId])
  @@index([status])
  @@map("projects")
}

model ProjectTask {
  id              String        @id @default(uuid())
  projectId       String
  title           String
  description     String?
  status          String        @default("TODO")
  priority        String        @default("MEDIUM")
  dueDate         DateTime?
  assignedTo      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("project_tasks")
}

// ============================================================================
// DRIP AUTOMATION SEQUENCES & AI CALL SUMMARIES
// ============================================================================

model AutomationSequence {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  triggerStage    String         @default("NEW_LEAD")
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps           SequenceStep[]

  @@index([organizationId])
  @@map("automation_sequences")
}

model SequenceStep {
  id              String             @id @default(uuid())
  sequenceId      String
  delayDays       Int                @default(1)
  channel         String             @default("EMAIL") // EMAIL, WHATSAPP, SMS
  templateSubject String?
  templateBody    String

  sequence        AutomationSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  @@map("sequence_steps")
}

model CallSummary {
  id              String       @id @default(uuid())
  customerId      String
  rawNotes        String
  aiSummary       String
  objections      String?
  actionItems     String?
  sentiment       String?      @default("POSITIVE")
  createdAt       DateTime     @default(now())

  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@map("call_summaries")
}
